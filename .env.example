# Biến cho docker compose ở GỐC repo (tùy chọn) — sao chép thành .env nếu muốn đổi mặc định.
# KHÔNG commit .env (ADR-072). Giá trị dưới đây chỉ dành cho máy dev, cổng chỉ mở trên 127.0.0.1.
# Biến của từng app nằm ở apps/api/.env.example và apps/web/.env.example.

POSTGRES_PASSWORD=postgres_local_only
TASKFLOW_MIGRATOR_PASSWORD=migrator_local_only
TASKFLOW_APP_PASSWORD=app_local_only

POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
VALKEY_PORT=6379
