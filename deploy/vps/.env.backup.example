# Mẫu /opt/taskflow/.env.backup (job backup hằng ngày, B2 — docs/runbook/backup-restore.md §3–4). KHÔNG commit bản thật.
# Role taskflow_backup CHỈ SELECT (runbook deploy §B.4) — không dùng taskflow_app (có ghi) hay postgres (superuser).
# URL KHÔNG chứa mật khẩu (backup.sh từ chối URL có mật khẩu — lộ qua ps/log); mật khẩu ở PGPASSWORD
BACKUP_DATABASE_URL=postgresql://taskflow_backup@postgres:5432/taskflow
PGPASSWORD=change-me-backup-password
# Public key age (age1…) — khóa giải mã KHÔNG BAO GIỜ nằm trên VPS
BACKUP_AGE_RECIPIENTS=age1change-me
BACKUP_S3_BUCKET=change-me-bucket
BACKUP_S3_ENDPOINT=https://change-me.s3-compatible.example
BACKUP_S3_PREFIX=taskflow/
# Credential CHỈ PutObject trên taskflow/* — máy bị chiếm cũng không xóa được bản cũ
AWS_ACCESS_KEY_ID=change-me-putobject-only
AWS_SECRET_ACCESS_KEY=change-me-putobject-only
AWS_DEFAULT_REGION=auto
# Heartbeat uptime monitor (gói free): không ping > 26 h ⇒ email
BACKUP_HEARTBEAT_URL=
