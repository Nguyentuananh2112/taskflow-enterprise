# Mẫu /opt/taskflow/.env trên VPS (biến của compose.prod.yml). KHÔNG commit bản thật (ADR-072).
# Sinh bằng: bash bootstrap.sh (điền ngẫu nhiên các mật khẩu, giữ nguyên phần còn lại để sửa tay).
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
GHCR_OWNER=CHANGE_ME
# deploy.sh tự ghi 4 dòng dưới (digest đã qua staging):
GIT_SHA=CHANGE_ME
API_DIGEST=sha256:CHANGE_ME
WEB_DIGEST=sha256:CHANGE_ME
MIGRATE_DIGEST=sha256:CHANGE_ME
# Image backup (B2) — deploy.sh ghi khi có
BACKUP_DIGEST=sha256:CHANGE_ME
# [SECRET] — bootstrap.sh sinh ngẫu nhiên
POSTGRES_PASSWORD=change-me-generated-by-bootstrap
TASKFLOW_MIGRATOR_PASSWORD=change-me-generated-by-bootstrap
TASKFLOW_APP_PASSWORD=change-me-generated-by-bootstrap
VALKEY_PASSWORD=change-me-generated-by-bootstrap
WEB_SENTRY_DSN=
