# Mẫu /opt/taskflow/.env.api — biến của API production trên VPS (khớp apps/api/src/config/env.ts).
# bootstrap.sh sinh bản thật từ file này (thay mật khẩu/secret). KHÔNG commit bản thật (ADR-072).
# NODE_ENV=production ⇒ app TỰ từ chối khởi động nếu: COOKIE_SECURE≠true, REDIS_URL không phải rediss://,
# CORS_ORIGINS không https, secret mẫu (change-me…/test-only…), thiếu METRICS_TOKEN… (devops.md §2.4).
NODE_ENV=production
APP_ENV=production
PORT=4000
# taskflow_app — CHỈ DML (grant bởi job migrate). Cấm dùng taskflow_migrator cho app.
DATABASE_URL=postgresql://taskflow_app:__TASKFLOW_APP_PASSWORD__@postgres:5432/taskflow
DATABASE_POOL_MAX=10
REDIS_URL=rediss://:__VALKEY_PASSWORD__@valkey:6379
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
CORS_ORIGINS=https://__APP_DOMAIN__
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
SENTRY_DSN=
METRICS_TOKEN=__METRICS_TOKEN__
SOCKET_REDIS_ADAPTER=false
