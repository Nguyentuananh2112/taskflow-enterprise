{
  "name": "@taskflow/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.js",
    "typecheck": "prisma generate --no-hints && tsc --noEmit",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:check-drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "test:integration": "prisma generate --no-hints && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@socket.io/redis-adapter": "catalog:",
    "@taskflow/contracts": "workspace:*",
    "cors": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "jose": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "rate-limit-redis": "catalog:",
    "redis": "catalog:",
    "socket.io": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@taskflow/config": "workspace:*",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "prisma": "catalog:",
    "socket.io-client": "catalog:",
    "supertest": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
