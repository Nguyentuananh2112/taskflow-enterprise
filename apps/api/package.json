    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
