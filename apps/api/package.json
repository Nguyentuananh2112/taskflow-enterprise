{
  "name": "@taskflow/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@node-rs/argon2": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@taskflow/contracts": "workspace:*",
    "cors": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "jose": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "redis": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@taskflow/config": "workspace:*",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "supertest": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
