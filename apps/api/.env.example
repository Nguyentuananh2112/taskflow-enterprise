# Mẫu biến môi trường apps/api — sao chép thành apps/api/.env (KHÔNG commit .env — ADR-072).
# KHỚP 1-1 với apps/api/src/config/env.ts (nguồn sự thật; thêm/bớt biến ⇒ sửa cả hai).
# Giá trị dưới đây chỉ cho máy dev, khớp docker-compose.yml (cổng host ADR-097: Postgres 5435, Valkey 6380, web 3001).
# Staging/prod: sinh secret mới (vd `openssl rand -base64 48`); giá trị `change-me…`/`test-only…` bị từ chối ở production.
# [SECRET] = không bao giờ commit giá trị thật, không gửi cho agent.

# --- Runtime ---
NODE_ENV=development
# local | test | staging | production — NODE_ENV=production chỉ đi với staging|production
APP_ENV=local
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Image đặt bằng build-arg; local để "dev".
GIT_SHA=dev

# --- PostgreSQL 18 ---
# [SECRET] App dùng user CHỈ có DML (taskflow_app). Migrate dùng taskflow_migrator — xem docs/runbook/local-dev.md §5.
DATABASE_URL=postgresql://taskflow_app:app_local_only@127.0.0.1:5435/taskflow
DATABASE_POOL_MAX=10

# --- Valkey (ADR-063; giao thức RESP nên giữ tên REDIS_URL). Production bắt buộc rediss:// ---
# [SECRET]
REDIS_URL=redis://127.0.0.1:6380
SOCKET_REDIS_ADAPTER=false
# Không nhận byte nào từ Valkey trong khoảng này (ms, 500–30000) ⇒ hủy socket ⇒ login/register/refresh
# trả 503 (fail-closed, ADR-108). Chỉ nâng khi Valkey ở xa / mạng trễ; không dùng để che CPU nghẽn.
VALKEY_SOCKET_TIMEOUT_MS=3000

# --- JWT access token (security.md §2.1, ADR-098) ---
# [SECRET] Chuỗi UTF-8 ≥ 32 byte (không phải base64). `kid` suy ra từ secret — không có biến KID riêng.
JWT_ACCESS_SECRET=change-me-local-only-not-a-real-secret-32bytes
# Chỉ đặt trong cửa sổ xoay khóa (devops.md §2.5), phải khác JWT_ACCESS_SECRET:
# JWT_ACCESS_SECRET_PREVIOUS=
# CHỈ APP_ENV=test (E2E token hết hạn nhanh), 5–900 giây; môi trường khác có biến này ⇒ từ chối khởi động.
# Không đặt ⇒ 900 giây (security.md §2.1).
# JWT_ACCESS_TTL_SECONDS=

# --- HTTP / cookie / proxy (security.md §2.3, §6) ---
# Danh sách origin, phân cách dấu phẩy. Production chỉ https://
CORS_ORIGINS=http://localhost:3001
# Production bắt buộc true.
COOKIE_SECURE=false
# Số proxy đứng trước app; local không có proxy.
TRUST_PROXY_HOPS=0

# --- Vòng đời (devops.md §7.3) ---
SHUTDOWN_TIMEOUT_MS=20000
READINESS_DRAIN_MS=5000

# --- Job bảo trì (T-033): purge workspace hết ân hạn (ADR-095) ---
# Không đặt ⇒ bật ở staging/production, tắt ở local/test.
# MAINTENANCE_JOBS_ENABLED=
# Chu kỳ (60 000–86 400 000 ms) và jitter (0–3 600 000 ms)
# PURGE_INTERVAL_MS=3600000
# PURGE_JITTER_MS=300000

# --- Thời hạn lưu dữ liệu cá nhân Mốc 3 (T-043, R27 — docs/design/data-retention.md) ---
# Đơn vị NGÀY; mặc định = phương án B. Job retention chạy mỗi ngày khi MAINTENANCE_JOBS_ENABLED bật.
# IP / User-Agent lượt chấm ⇒ NULL (30–3660)
# RETENTION_CLIENT_INFO_DAYS=395
# Lý do nghỉ ⇒ NULL, tính từ ngày kết thúc đơn, trừ đơn đang chờ (30–3660)
# RETENTION_LEAVE_REASON_DAYS=395
# Xóa lượt chấm, đơn + số dư (theo cả năm), nhiệm kỳ đã kết thúc (365–3660)
# RETENTION_RECORDS_DAYS=730
# Xóa thông báo (30–3660)
# RETENTION_NOTIFICATIONS_DAYS=180
# Xóa nhật ký thao tác nhân sự (365–3660)
# RETENTION_HR_AUDIT_DAYS=1826

# --- Lưu trữ (T-020) ---
# prisma (mặc định) | memory — memory MẤT dữ liệu khi khởi động lại; bị TỪ CHỐI ở staging/production
PERSISTENCE=prisma

# --- Observability (ADR-073, T-035) — xem docs/runbook/alerts.md ---
# DSN project Sentry `taskflow-api`. Thiếu ở staging/production ⇒ CẢNH BÁO lúc khởi động, app vẫn chạy.
# Repo public ⇒ đặt qua biến môi trường của nền tảng, không commit.
# SENTRY_DSN=
# Tỉ lệ lấy mẫu trace (0…1), thấp để nằm trong quota gói miễn phí
# SENTRY_TRACES_SAMPLE_RATE=0.05
# /metrics (Prometheus) trên cổng NỘI BỘ riêng — KHÔNG map ra Internet. 0 = cổng trống bất kỳ.
# METRICS_PORT=9464
# Mặc định 127.0.0.1 (chỉ loopback). Đặt 0.0.0.0 TƯỜNG MINH khi nền tảng scrape qua mạng nội bộ.
# METRICS_HOST=127.0.0.1
# [SECRET] ≥ 32 ký tự — bắt buộc ở staging/production: Bearer token cho /metrics (lớp thứ hai)
# METRICS_TOKEN=
