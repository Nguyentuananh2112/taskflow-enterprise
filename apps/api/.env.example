# Mẫu biến môi trường apps/api — sao chép thành apps/api/.env (KHÔNG commit .env — ADR-072).
# Nguồn: docs/design/devops.md §2.2 + docs/design/security.md. Giá trị dưới đây chỉ cho máy dev,
# khớp docker-compose.yml. Staging/prod sinh secret mới: openssl rand -base64 48
# Đánh dấu [SECRET] = không bao giờ commit giá trị thật, không gửi cho agent.

# --- Runtime ---
NODE_ENV=development
# local | test | staging | production — chặn seed khi production
APP_ENV=local
PORT=4000
LOG_LEVEL=debug
# Image đặt bằng build-arg; local để "dev".
GIT_SHA=dev

# --- PostgreSQL 18 ---
# [SECRET] App kết nối bằng user CHỈ có DML (taskflow_app).
DATABASE_URL=postgresql://taskflow_app:app_local_only@127.0.0.1:5432/taskflow
DATABASE_POOL_MAX=10
# [SECRET] User có DDL, CHỈ dùng cho migrate/seed. Job migrate trong container nhận giá trị này qua
# chính biến DATABASE_URL (prisma.config.ts chỉ đọc DATABASE_URL — ADR-061). Local: xem docs/runbook/local-dev.md.
MIGRATOR_DATABASE_URL=postgresql://taskflow_migrator:migrator_local_only@127.0.0.1:5432/taskflow
# [SECRET] Postgres test (compose service postgres-test, cổng 5433). Harness tạo DB mỗi worker từ taskflow_template.
TEST_MIGRATOR_DATABASE_URL=postgresql://taskflow_migrator:migrator_local_only@127.0.0.1:5433/taskflow_template

# --- Valkey (ADR-063; giao thức RESP nên giữ tên REDIS_URL). Prod bắt buộc rediss:// ---
# [SECRET]
REDIS_URL=redis://127.0.0.1:6379
SOCKET_REDIS_ADAPTER=false

# --- JWT access token (security.md §2.1) ---
# [SECRET] base64, giải mã ra >= 32 byte. Giá trị dưới đây là mẫu công khai — app phải từ chối nó ở production.
JWT_ACCESS_SECRET=Y2hhbmdlLW1lLWxvY2FsLW9ubHktbm90LWEtcmVhbC1zZWNyZXQtMzJieXRlcw==
JWT_ACCESS_KID=local-1
# Chỉ đặt trong cửa sổ xoay khóa (devops.md §2.5):
# JWT_ACCESS_SECRET_PREVIOUS=
# JWT_ACCESS_KID_PREVIOUS=

# --- HTTP / cookie / proxy (security.md §2.3, §6) ---
CORS_ORIGINS=http://localhost:3000
# Production bắt buộc true (app không khởi động nếu false).
COOKIE_SECURE=false
# Số proxy đứng trước app; local không có proxy.
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=20000

# --- Observability (ADR-073) ---
# SENTRY_DSN=
# [SECRET] bảo vệ /metrics khi không tách được cổng nội bộ
# METRICS_TOKEN=
