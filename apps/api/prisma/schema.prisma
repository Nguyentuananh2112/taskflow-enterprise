// Prisma 7.10.0 (ADR-060/062, stack-versions §8.1). URL nằm ở apps/api/prisma.config.ts:
//   datasource: { url: process.env.DATABASE_URL ?? "" }   (ADR-061; không dùng env())
// Client tạo ở composition root với driver adapter @prisma/adapter-pg (ADR-016).
// Luôn chạy CLI bằng `pnpm exec prisma`, cấm `npx prisma` (ADR-061).
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql" // không có url ở đây
}

enum WorkspaceRole {
  OWNER
  PM
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskAuditAction {
  CREATED
  UPDATED // title/description/priority/dueDate
  STATUS_CHANGED // đổi cột (có thể kèm đổi rank)
  MOVED // chỉ đổi rank trong cùng cột
  ASSIGNEE_CHANGED
  DELETED
}

enum RefreshTokenRevokeReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  PASSWORD_CHANGED
  USER_DELETED
  OFFBOARDED // Mốc 3.5: nghỉ việc công ty (ADR-137)
}

// ---- Mốc 3.5 (company-level.md, ADR-133…140): một công ty ----
enum CompanyRole {
  ADMIN // quản trị — KHÔNG phải nhân viên (không chấm công / xin nghỉ)
  EMPLOYEE
}

enum CompanyGrant {
  HR_MANAGE
  PAYROLL_MANAGE // dùng từ Mốc 4; khai sẵn cho parity
}

enum DepartureReason {
  OFFBOARDED // nghỉ việc
  ROLE_CHANGED // nâng EMPLOYEE → ADMIN: đóng nhiệm kỳ chấm công
}

// ---- Mốc 3 (attendance-leave.md §3, ADR-120…123) ----

enum AttendanceKind {
  IN
  OUT
}

enum AttendanceSource {
  WEB
  DEVICE // máy chấm công — để sau (§7), chừa chỗ
  ADJUSTMENT // HR thêm tay (bắt buộc lý do)
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL_PAID
  UNPAID
  OTHER
}

enum LeaveDayPart {
  FULL
  AM
  PM
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
}

enum NotificationType {
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
  LEAVE_REVOKED
  ATTENDANCE_ADJUSTED
  ACCESS_CHANGED // Mốc 3.5: đổi role / grant công ty (thay HR_GRANTED / HR_REVOKED)
  OFFBOARD_SCHEDULED
  OFFBOARD_CLEANUP
  PROFILE_UPDATED // Mốc 5 (ADR-128): HR sửa hồ sơ của bạn
  CORRECTION_SUBMITTED // Mốc 5 (ADR-129): đơn bổ sung giờ — SUBMITTED / CANCELLED dành cho HR
  CORRECTION_APPROVED
  CORRECTION_REJECTED
  CORRECTION_CANCELLED
  PAYSLIP_PUBLISHED // Mốc 4 (payroll.md §4): phiếu tháng đã phát hành — không số tiền
  PAYSLIP_REVISED // bản điều chỉnh phiếu của bạn
  PAYROLL_REMINDER // nhắc kế toán từ ngày 5 tới khi phát hành
}

enum PayrollRunStatus {
  DRAFT
  PUBLISHED
}

enum PayslipSection {
  INCOME
  BONUS
  DEDUCTION
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                   String                @id @default(uuid(7)) @db.Uuid
  email                String                @unique @db.VarChar(254) // trim+lowercase+NFC ở app; CHECK (email = lower(email)) bằng SQL tay
  passwordHash         String?               @map("password_hash") // NULL = chờ kích hoạt (ADR-137); argon2id PHC string `$argon2id$v=19$…` (ADR-065)
  fullName             String                @map("full_name") @db.VarChar(100)
  tokenVersion         Int                   @default(0) @map("token_version") // ADR-025
  passwordChangedAt    DateTime?             @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt          DateTime?             @map("last_login_at") @db.Timestamptz(3)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(3) // D2; khác null ⇒ login/refresh bị từ chối như sai thông tin; set cùng tx với tăng token_version + thu hồi token (USER_DELETED)
  avatarVersion        Int?                  @map("avatar_version") // Mốc 6 (ADR-142): blob avatars/<id>/<v>/{256,64}; NULL = chữ cái; CHECK 1…999999999 bằng SQL tay
  // T-075 (data-retention §5): xác nhận thông báo quyền riêng tư theo PHIÊN BẢN + đồng ý riêng cho lý do nghỉ.
  privacyAckVersion    Int?                  @map("privacy_ack_version") // CHECK > 0 bằng SQL tay
  privacyAckAt         DateTime?             @map("privacy_ack_at") @db.Timestamptz(3)
  consentLeaveReason   Boolean               @default(false) @map("consent_leave_reason")
  consentLeaveReasonAt DateTime?             @map("consent_leave_reason_at") @db.Timestamptz(3)
  privacyConsentEvents PrivacyConsentEvent[]
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships       WorkspaceMember[]
  refreshTokens     RefreshToken[]
  assignedTasks     Task[]            @relation("TaskAssignee")
  createdTasks      Task[]            @relation("TaskCreator")
  auditLogs         TaskAuditLog[]
  deletedWorkspaces Workspace[]       @relation("WorkspaceDeleter")

  // Mốc 3: mọi tham chiếu tới users là Restrict (như actor của TaskAuditLog — D3) — lịch sử công / đơn /
  // số dư không mất khi rời workspace; v1 không xóa cứng user (D2 ẩn danh hóa).
  attendanceEvents        AttendanceEvent[] @relation("AttendanceUser")
  attendanceEventsCreated AttendanceEvent[] @relation("AttendanceCreator")
  attendanceEventsVoided  AttendanceEvent[] @relation("AttendanceVoider")
  workSchedulesCreated    WorkSchedule[]    @relation("ScheduleCreator")
  leaveRequests           LeaveRequest[]    @relation("LeaveRequester")
  leaveRequestsDecided    LeaveRequest[]    @relation("LeaveDecider")
  leaveBalances           LeaveBalance[]
  leavePoliciesUpdated    LeavePolicy[]     @relation("LeavePolicyUpdater")
  notificationsReceived   Notification[]    @relation("NotificationRecipient")
  notificationsActed      Notification[]    @relation("NotificationActor")
  hrAuditLogs             HrAuditLog[]

  // Mốc 3.5
  companyMember          CompanyMember?           @relation("CompanyMemberUser")
  offboardsScheduled     CompanyMember[]          @relation("OffboardScheduler")
  companyDepartures      CompanyMemberDeparture[]
  activationTokens       AccountActivationToken[] @relation("ActivationTokenUser")
  activationTokensIssued AccountActivationToken[] @relation("ActivationTokenCreator")

  // Mốc 5 (T-054, ADR-128)
  employeeProfile EmployeeProfile?  @relation("ProfileUser")
  profilesUpdated EmployeeProfile[] @relation("ProfileUpdater")

  // Mốc 4 (T-048, payroll.md §3) — Restrict: phiếu của người đã nghỉ giữ theo hạn lưu lương
  payrollSettingsUpdated PayrollSettings[] @relation("PayrollSettingsUpdater")
  salaryProfiles         SalaryProfile[]   @relation("SalaryProfileUser")
  salaryProfilesCreated  SalaryProfile[]   @relation("SalaryProfileCreator")
  payrollRunsCreated     PayrollRun[]      @relation("PayrollRunCreator")
  payrollRunsPublished   PayrollRun[]      @relation("PayrollRunPublisher")
  payslips               Payslip[]         @relation("PayslipUser")

  // Mốc 5 (T-055, ADR-129)
  correctionRequests       AttendanceCorrectionRequest[] @relation("CorrectionRequester")
  correctionsDecided       AttendanceCorrectionRequest[] @relation("CorrectionDecider")
  // Mốc 6 — trò chuyện (T-069a, ADR-143/144): mọi tham chiếu tới users là Restrict (v1 không xóa cứng user).
  chatConversationsCreated ChatConversation[]            @relation("ChatConversationCreator")
  chatParticipations       ChatParticipant[]
  chatReadStates           ChatReadState[]
  chatMessagesSent         ChatMessage[]
  chatUploads              ChatAttachment[]

  @@map("users")
}

model RefreshToken {
  id              String                    @id @default(uuid(7)) @db.Uuid
  userId          String                    @map("user_id") @db.Uuid
  tokenHash       String                    @unique @map("token_hash") @db.Char(64) // SHA-256 hex
  familyId        String                    @map("family_id") @db.Uuid // nhóm phiên, KHÔNG phải FK
  replacedById    String?                   @unique @map("replaced_by_id") @db.Uuid
  expiresAt       DateTime                  @map("expires_at") @db.Timestamptz(3) // = min(now+7d, familyExpiresAt)
  familyExpiresAt DateTime                  @map("family_expires_at") @db.Timestamptz(3) // hạn tuyệt đối phiên (30 ngày từ login), copy khi xoay
  revokedAt       DateTime?                 @map("revoked_at") @db.Timestamptz(3)
  revokedReason   RefreshTokenRevokeReason? @map("revoked_reason")
  userAgent       String?                   @map("user_agent") @db.VarChar(255) // cắt 255, chỉ forensics/danh sách phiên
  ip              String?                   @db.Inet
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Workspace {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(50) // vẫn giữ chỗ khi xóa mềm → khôi phục không đụng slug
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3) // ADR-047
  purgeAt     DateTime? @map("purge_at") @db.Timestamptz(3) // = deleted_at + 30 ngày
  deletedById String?   @map("deleted_by_id") @db.Uuid
  version     Int       @default(1) // ADR-110: optimistic lock — mọi ghi là UPDATE … WHERE version
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3) // Mốc 3.5: Admin lưu trữ ws mồ côi 0 thành viên (ADR-134)

  deletedBy        User?             @relation("WorkspaceDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  members          WorkspaceMember[]
  projects         Project[]
  // Mốc 6: phòng trò chuyện của ws (tạo lười, Cascade khi purge — R20).
  chatConversation ChatConversation?

  @@index([purgeAt], map: "workspaces_purge_at_idx", where: raw("purge_at IS NOT NULL")) // partialIndexes (ADR-062)
  @@index([deletedById])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role]) // ADR-051: khóa dòng OWNER (ADR-046)
  @@map("workspace_members")
}

// ---------------------------------------------------------------- Mốc 3.5: công ty (ADR-133…137)
// CHECK constraint: SQL tay trong migration company_level.

/// Đúng MỘT dòng (CHECK id = 1) — tạo bởi `admin:bootstrap` / seed.
model Company {
  id             Int      @id @db.SmallInt
  name           String   @db.VarChar(100)
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  // T-075: đầu mối liên hệ về dữ liệu cá nhân (chữ tự do); NULL ⇒ web hiện "liên hệ quản trị viên".
  privacyContact String?  @map("privacy_contact") @db.VarChar(200)

  @@map("companies")
}

/// Dòng tồn tại ⇔ đang thuộc công ty (kể cả chờ kích hoạt, đang có lịch nghỉ). Nghỉ việc = xóa dòng + departure
/// cùng transaction. Nhiệm kỳ chấm công = thời gian có role EMPLOYEE (`start_date`, theo NGÀY).
model CompanyMember {
  userId                String         @id @map("user_id") @db.Uuid
  role                  CompanyRole
  grants                CompanyGrant[] @default([]) // chỉ EMPLOYEE (CHECK)
  startDate             DateTime?      @map("start_date") @db.Date // EMPLOYEE ⇔ khác null (CHECK)
  offboardLastDay       DateTime?      @map("offboard_last_day") @db.Date
  offboardAccessUntil   DateTime?      @map("offboard_access_until") @db.Timestamptz(3) // 06:00 ngày sau last_day theo lịch
  offboardScheduledById String?        @map("offboard_scheduled_by_id") @db.Uuid
  version               Int            @default(1)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                User  @relation("CompanyMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  offboardScheduledBy User? @relation("OffboardScheduler", fields: [offboardScheduledById], references: [id], onDelete: Restrict)

  @@index([offboardAccessUntil], map: "company_members_offboard_access_until_idx", where: raw("offboard_access_until IS NOT NULL")) // job hoàn tất mỗi phút
  @@index([role]) // last-admin guard
  @@index([offboardScheduledById])
  @@map("company_members")
}

/// Nhiệm kỳ EMPLOYEE đã đóng (nghỉ việc / nâng lên Admin). `left_at` chỉ để audit; nhiệm kỳ so theo ngày.
model CompanyMemberDeparture {
  id       String          @id @db.Uuid
  userId   String          @map("user_id") @db.Uuid
  role     CompanyRole
  firstDay DateTime        @map("first_day") @db.Date
  lastDay  DateTime        @map("last_day") @db.Date
  leftAt   DateTime        @map("left_at") @db.Timestamptz(3)
  reason   DepartureReason

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([lastDay])
  @@map("company_member_departures")
}

/// ADR-137: token kích hoạt — DB chỉ lưu SHA-256; một lần; mỗi user ≤ 1 token sống.
model AccountActivationToken {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid // NULL = do `admin:bootstrap` cấp
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User  @relation("ActivationTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ActivationTokenCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([userId], map: "account_activation_tokens_live_key", where: raw("used_at IS NULL AND revoked_at IS NULL"))
  @@index([expiresAt])
  @@index([createdById])
  @@map("account_activation_tokens")
}

model Project {
  id             String    @id @default(uuid(7)) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  name           String    @db.VarChar(100)
  keyPrefix      String    @map("key_prefix") @db.VarChar(10) // ^[A-Z][A-Z0-9]{1,9}$, bất biến
  description    String?   @db.VarChar(2000)
  nextTaskNumber Int       @default(1) @map("next_task_number")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  version        Int       @default(1) // ADR-110; `allocateTaskNumber` KHÔNG tăng (bộ đếm, không phải sửa của người dùng)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([workspaceId, keyPrefix])
  @@unique([id, workspaceId]) // đích của FK kép từ tasks (D6)
  @@index([workspaceId, archivedAt])
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  number      Int
  title       String       @db.VarChar(150)
  description String? // ≤ 10 000 ký tự, kiểm ở app
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  rank        String // COLLATE "C" — thêm tay trong migration (mục 1.3)
  version     Int          @default(1)
  dueDate     DateTime?    @map("due_date") @db.Date
  assigneeId  String?      @map("assignee_id") @db.Uuid
  createdById String?      @map("created_by_id") @db.Uuid // ADR-022
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project        @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  assignee  User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  auditLogs TaskAuditLog[]

  @@unique([projectId, number])
  @@unique([projectId, status, rank], map: "tasks_rank_live_key", where: raw("deleted_at IS NULL")) // ADR-062; phục vụ cả đọc board (query luôn có deleted_at IS NULL)
  @@index([assigneeId])
  @@index([createdById])
  @@map("tasks")
}

model TaskAuditLog {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid // D5, không FK
  projectId   String          @map("project_id") @db.Uuid // D5, không FK
  taskId      String          @map("task_id") @db.Uuid
  actorId     String          @map("actor_id") @db.Uuid
  action      TaskAuditAction
  oldValue    Json?           @map("old_value")
  newValue    Json?           @map("new_value")
  requestId   String?         @map("request_id") @db.VarChar(64) // truy vết với log pino
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict) // D3

  @@index([taskId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("task_audit_logs")
}

// ---------------------------------------------------------------- Mốc 3: chấm công & nghỉ phép
// Mốc 3.5 (ADR-136): thuộc CÔNG TY — không còn `workspace_id`; purge workspace không đụng dữ liệu HR.
// CHECK constraint: SQL tay trong migration 20261017000000_hr_attendance_leave. Không seed lịch: lịch mặc định là hằng số
// của domain attendance (Tech Lead, T-037) — dòng work_schedules chỉ có khi HR lưu.

/// ADR-120/121: lịch làm việc có phiên bản theo ngày hiệu lực; múi giờ nằm trong phiên bản.
model WorkSchedule {
  id            String   @id @default(uuid(7)) @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  timezone      String   @default("Asia/Ho_Chi_Minh") @db.VarChar(64) // IANA, kiểm ở app (Intl.supportedValuesOf)
  workdays      Int // bitmask: bit0 = T2 … bit6 = CN
  startMin      Int      @map("start_min") // phút từ 00:00 theo `timezone`
  endMin        Int      @map("end_min")
  breakStartMin Int      @map("break_start_min")
  breakEndMin   Int      @map("break_end_min")
  graceMin      Int      @default(0) @map("grace_min")
  createdById   String   @map("created_by_id") @db.Uuid // HR lưu lịch (không có bản seed — lịch mặc định là hằng số của domain attendance)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User @relation("ScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([effectiveFrom])
  @@index([createdById])
  @@map("work_schedules")
}

model Holiday {
  date DateTime @id @db.Date
  name String   @db.VarChar(100)

  @@map("holidays")
}

/// ADR-121: log sự kiện bất biến — chỉ thêm; sai ⇒ HR hủy (voided*) + thêm lượt ADJUSTMENT.
model AttendanceEvent {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  kind           AttendanceKind
  source         AttendanceSource
  occurredAt     DateTime         @map("occurred_at") @db.Timestamptz(3) // giờ SERVER (client không gửi giờ)
  workDate       DateTime         @map("work_date") @db.Date // lưu cứng lúc ghi (ADR-120)
  ip             String?          @db.Inet // dữ liệu cá nhân — chỉ HR + chính chủ (R27)
  userAgent      String?          @map("user_agent") @db.VarChar(256)
  deviceId       String?          @map("device_id") @db.VarChar(64)
  idempotencyKey String?          @map("idempotency_key") @db.VarChar(64) // UUID (Zod) — theo user
  note           String?          @db.VarChar(500)
  createdById    String           @map("created_by_id") @db.Uuid
  voidedAt       DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidedById     String?          @map("voided_by_id") @db.Uuid
  voidReason     String?          @map("void_reason") @db.VarChar(500)

  user      User  @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User  @relation("AttendanceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy  User? @relation("AttendanceVoider", fields: [voidedById], references: [id], onDelete: Restrict)

  correction AttendanceCorrectionRequest? // Mốc 5: lượt ADJUSTMENT do duyệt đơn bổ sung giờ (ADR-129)

  @@unique([userId, workDate], map: "attendance_events_web_in_once_key", where: raw("kind = 'IN' AND source = 'WEB' AND voided_at IS NULL"))
  @@unique([userId, source, idempotencyKey], map: "attendance_events_idempotency_key", where: raw("idempotency_key IS NOT NULL"))
  @@index([workDate])
  @@index([userId, workDate])
  @@index([createdById])
  @@index([voidedById])
  @@map("attendance_events")
}

/// ADR-122: số ngày KHÔNG lưu — tính khi đọc từ lịch + ngày lễ (D-H3a).
model LeaveRequest {
  id           String       @id @default(uuid(7)) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  type         LeaveType
  startDate    DateTime     @map("start_date") @db.Date
  endDate      DateTime     @map("end_date") @db.Date
  dayPart      LeaveDayPart @default(FULL) @map("day_part")
  reason       String?      @db.VarChar(1000) // có thể là dữ liệu sức khỏe (B-H2): chỉ người gửi + HR đọc
  status       LeaveStatus  @default(PENDING)
  decidedById  String?      @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?    @map("decided_at") @db.Timestamptz(3)
  decisionNote String?      @map("decision_note") @db.VarChar(500)
  version      Int          @default(1) // ADR-110
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User  @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy User? @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, startDate, id])
  @@index([status, createdAt, id])
  @@index([userId, startDate])
  @@index([decidedById])
  @@map("leave_requests")
}

model LeaveBalance {
  userId          String   @map("user_id") @db.Uuid
  year            Int
  /// T-057 (ADR-131): NULL = theo chính sách năm (tính khi đọc); khác NULL = ghi đè cố định.
  entitledDays    Decimal? @map("entitled_days") @db.Decimal(4, 1)
  adjustmentDays  Decimal  @default(0) @map("adjustment_days") @db.Decimal(4, 1)
  /// Phép năm trước chuyển sang, chụp ở đường ghi / job 01/01; NULL = chưa chụp (đọc ⇒ tính tạm).
  carriedOverDays Decimal? @map("carried_over_days") @db.Decimal(4, 1)
  version         Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, year])
  @@map("leave_balances")
}

/// Chính sách phép một năm cho cả công ty (T-057, ADR-131). Năm chưa có dòng ⇒ dòng gần nhất trước đó, không có ⇒
/// mức luật. Giới hạn = CHECK của migration (không thấp hơn luật: 12 ngày, +1 mỗi ≤ 5 năm).
model LeavePolicy {
  year                 Int      @id
  annualDays           Decimal  @default(12) @map("annual_days") @db.Decimal(4, 1)
  seniorityStepYears   Int      @default(5) @map("seniority_step_years")
  seniorityBonusDays   Decimal  @default(1) @map("seniority_bonus_days") @db.Decimal(3, 1)
  carryOverEnabled     Boolean  @default(false) @map("carry_over_enabled")
  carryOverMaxDays     Decimal  @default(0) @map("carry_over_max_days") @db.Decimal(4, 1)
  carryOverExpiryMonth Int      @default(3) @map("carry_over_expiry_month")
  version              Int      @default(1)
  updatedById          String   @map("updated_by_id") @db.Uuid
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User @relation("LeavePolicyUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
  @@map("leave_policies")
}

/// ADR-123: thông báo bền — ghi cùng transaction với thay đổi; payload chỉ id + loại.
model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  type        NotificationType
  refId       String           @map("ref_id") @db.Uuid // id đơn / lượt chấm / thành viên — không FK (đa hình)
  actorId     String?          @map("actor_id") @db.Uuid
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([recipientId, readAt, createdAt])
  @@index([actorId])
  @@map("notifications")
}

/// Như TaskAuditLog: chỉ thêm. Chỉ Admin đọc (Mốc 3.5); before/after KHÔNG chép `reason` của đơn nghỉ (B-H2).
model HrAuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid // NULL = `admin:bootstrap` (CLI, không có người)
  action       String   @db.VarChar(32) // GRANT/REVOKE, SCHEDULE_SET, HOLIDAY_SET/DELETE, EVENT_ADJUST/VOID, LEAVE_*, BALANCE_ADJUST, EXPORT — tập giá trị chốt ở contracts
  targetUserId String?  @map("target_user_id") @db.Uuid // không FK (như D5)
  refId        String?  @map("ref_id") @db.Uuid
  before       Json?
  after        Json?
  requestId    String?  @map("request_id") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
  @@map("hr_audit_logs")
}

// ---------------------------------------------------------------- Mốc 5: hồ sơ nhân viên (ADR-128, T-054)
/// Một dòng / user, KHÔNG phiên bản, nguồn duy nhất của `hireDate` (lương + phép). Không FK tới `company_members`
/// (dòng đó bị xóa khi nghỉ việc) — người đã nghỉ giữ hồ sơ tới hạn lưu D8. CHECK: SQL tay trong migration.
model EmployeeProfile {
  userId      String    @id @map("user_id") @db.Uuid
  hireDate    DateTime? @map("hire_date") @db.Date
  department  String?   @db.VarChar(100)
  jobTitle    String?   @map("job_title") @db.VarChar(100)
  workPhone   String?   @map("work_phone") @db.VarChar(16) // đã chuẩn hóa: +? và chữ số
  version     Int       @default(1)
  updatedById String    @map("updated_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User @relation("ProfileUser", fields: [userId], references: [id], onDelete: Restrict)
  updatedBy User @relation("ProfileUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
  @@map("employee_profiles")
}

// ---------------------------------------------------------------- Mốc 5: đơn bổ sung giờ (ADR-129, T-055)
/// Nhân viên xin thêm lượt IN / OUT còn THIẾU của một ngày công; HR duyệt ⇒ một lượt ADJUSTMENT (`created_event_id`).
/// `reason` có thể nhắc sức khỏe (B-H2): chỉ người gửi + HR; NULL sau hạn lưu D9 (trừ PENDING). CHECK: SQL tay.
model AttendanceCorrectionRequest {
  id             String           @id @db.Uuid // UUIDv7 từ app
  userId         String           @map("user_id") @db.Uuid
  workDate       DateTime         @map("work_date") @db.Date
  kind           AttendanceKind
  minuteOfDay    Int              @map("minute_of_day") // phút từ 00:00 theo múi giờ lịch hiệu lực
  nextDay        Boolean          @default(false) @map("next_day") // OUT sau nửa đêm, < 06:00
  reason         String?          @db.VarChar(500)
  status         CorrectionStatus @default(PENDING)
  idempotencyKey String           @map("idempotency_key") @db.VarChar(64)
  decidedById    String?          @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?        @map("decided_at") @db.Timestamptz(3)
  decisionNote   String?          @map("decision_note") @db.VarChar(500)
  createdEventId String?          @unique @map("created_event_id") @db.Uuid
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User             @relation("CorrectionRequester", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy    User?            @relation("CorrectionDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  // NO ACTION (không Restrict): kiểm CUỐI câu lệnh ⇒ retention xóa đơn rồi lượt chấm trong một lượt không vỡ (B-HIGH-2).
  createdEvent AttendanceEvent? @relation(fields: [createdEventId], references: [id], onDelete: NoAction)

  @@unique([userId, workDate, kind], map: "attendance_corrections_pending_key", where: raw("status = 'PENDING'"))
  @@unique([userId, idempotencyKey])
  @@index([status, createdAt, id])
  @@index([userId, workDate])
  @@index([decidedById])
  @@map("attendance_correction_requests")
}

// ================================================================ Mốc 6 — trò chuyện (T-069a; avatar-chat.md §3, ADR-143/144)
// CHECK (loại ⇔ cột, thân ≤ 4 000, kích thước ≥ 0) nằm trong migration SQL — Prisma không biểu diễn được.

enum ChatConversationKind {
  DIRECT
  GROUP
  WORKSPACE

  @@map("chat_conversation_kind")
}

enum ChatParticipantRole {
  OWNER
  MEMBER

  @@map("chat_participant_role")
}

enum ChatAttachmentKind {
  IMAGE
  FILE

  @@map("chat_attachment_kind")
}

model ChatConversation {
  id            String               @id @default(uuid(7)) @db.Uuid
  kind          ChatConversationKind
  title         String?              @db.VarChar(80) // GROUP: bắt buộc
  directKey     String?              @unique @map("direct_key") @db.VarChar(73) // DIRECT: "<uuid nhỏ>:<uuid lớn>"
  workspaceId   String?              @unique @map("workspace_id") @db.Uuid // WORKSPACE: tạo lười
  createdById   String               @map("created_by_id") @db.Uuid
  lastMessageAt DateTime?            @map("last_message_at") @db.Timestamptz(3)
  lastMessageId String?              @map("last_message_id") @db.Uuid // không FK (cập nhật trong transaction gửi)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("ChatConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants ChatParticipant[]
  readStates   ChatReadState[]
  messages     ChatMessage[]

  @@index([createdById])
  @@map("chat_conversations")
}

/// Chỉ DIRECT / GROUP (WORKSPACE tính từ workspace_members). Hiệu lực: left_at NULL VÀ joined_at ≥ company_members.created_at (ADR-143).
model ChatParticipant {
  conversationId String              @map("conversation_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  role           ChatParticipantRole @default(MEMBER)
  joinedAt       DateTime            @map("joined_at") @db.Timestamptz(3)
  leftAt         DateTime?           @map("left_at") @db.Timestamptz(3)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId, leftAt])
  @@map("chat_participants")
}

model ChatReadState {
  conversationId    String   @map("conversation_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  lastReadMessageId String?  @map("last_read_message_id") @db.Uuid // không FK (tin có thể bị purge)
  muted             Boolean  @default(false)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("chat_read_states")
}

model ChatMessage {
  id             String    @id @default(uuid(7)) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  clientMsgId    String    @map("client_msg_id") @db.Uuid
  requestHash    String    @map("request_hash") @db.Char(64)
  body           String? // NULL khi đã xóa / chỉ đính kèm; CHECK ≤ 4 000 ký tự ở SQL
  replyToId      String?   @map("reply_to_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyTo      ChatMessage?     @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]    @relation("ChatReply")
  attachments  ChatAttachment[]

  @@unique([senderId, clientMsgId])
  @@index([conversationId, createdAt, id])
  @@index([createdAt])
  @@index([replyToId])
  @@map("chat_messages")
}

model ChatAttachment {
  id           String             @id @default(uuid(7)) @db.Uuid
  uploaderId   String             @map("uploader_id") @db.Uuid
  messageId    String?            @map("message_id") @db.Uuid // NULL = upload chưa gắn (mồ côi sau 24 giờ)
  kind         ChatAttachmentKind
  originalName String             @map("original_name") @db.VarChar(255) // đã làm sạch — chỉ hiển thị
  mime         String             @db.VarChar(100)
  sizeBytes    Int                @map("size_bytes")
  sha256       String             @db.Char(64)
  width        Int?
  height       Int?
  fileKey      String             @unique @map("file_key") @db.VarChar(128) // một blob ⇔ một dòng (B M3)
  previewKey   String?            @map("preview_key") @db.VarChar(128)
  thumbKey     String?            @map("thumb_key") @db.VarChar(128)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  uploader User         @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  message  ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([createdAt], map: "chat_attachments_orphan_created_at_idx", where: raw("message_id IS NULL"))
  @@index([uploaderId, createdAt])
  @@index([previewKey]) // files-sweep existingBlobKeys (B M3)
  @@index([thumbKey])
  @@map("chat_attachments")
}

// ================================================================ T-075 — bằng chứng đồng ý (NĐ 13/2023 Đ.11; soát B M1)

enum PrivacyConsentKind {
  ACK // xác nhận đã đọc thông báo (value luôn true)
  LEAVE_REASON // đồng ý (true) / rút lại (false) xử lý lý do nghỉ

  @@map("privacy_consent_kind")
}

/// CHỈ THÊM: mỗi lần trạng thái đổi (cột trên `users` là bản đọc nhanh). Giữ 5 năm kể từ `at` (D16) rồi job retention xóa.
model PrivacyConsentEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  kind          PrivacyConsentKind
  value         Boolean
  noticeVersion Int                @map("notice_version") // phiên bản thông báo người đó đang xem lúc ghi — CHECK > 0 SQL tay
  at            DateTime           @db.Timestamptz(3) // giờ THẬT (bằng chứng)
  requestId     String?            @map("request_id") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, at])
  @@index([at])
  @@map("privacy_consent_events")
}

// ---------------------------------------------------------------- Mốc 4: phiếu lương (payroll.md v4 §3, T-048)
// Tiền BIGINT đồng (ADR-125); công là số nguyên NỬA ngày. CHECK + trigger bất biến: SQL tay trong migration 7.
// NGOÀI mọi bước retention hiện có (RD-11) — hạn lưu riêng chốt cùng R27.

/// Đúng MỘT dòng (CHECK id = 1) — migration INSERT (1, 500 000).
model PayrollSettings {
  id               Int      @id @db.SmallInt
  seniorityPerYear BigInt   @default(500000) @map("seniority_per_year")
  version          Int      @default(1)
  updatedById      String?  @map("updated_by_id") @db.Uuid // NULL = giá trị migration
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("PayrollSettingsUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
  @@map("payroll_settings")
}

/// Hồ sơ lương theo phiên bản từ kỳ `effective_from` (không có hireDate — ADR-128). Chỉ thêm, không sửa.
model SalaryProfile {
  id            String   @id @db.Uuid // UUIDv7 từ app
  userId        String   @map("user_id") @db.Uuid
  effectiveFrom String   @map("effective_from") @db.Char(7) // YYYY-MM
  level         String   @db.VarChar(32)
  baseSalary    BigInt   @map("base_salary")
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User @relation("SalaryProfileUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User @relation("SalaryProfileCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([userId, effectiveFrom])
  @@index([createdById])
  @@map("salary_profiles")
}

/// Bảng lương tháng — tạo nháp idempotent (unique period); PUBLISHED ⇒ trigger cấm mọi UPDATE / DELETE.
model PayrollRun {
  id               String           @id @db.Uuid
  period           String           @unique @db.Char(7) // YYYY-MM
  status           PayrollRunStatus @default(DRAFT)
  standardDays     Int              @map("standard_days") @db.SmallInt // công chuẩn S — ảnh chụp
  seniorityPerYear BigInt           @map("seniority_per_year") // ảnh chụp lúc tạo / tính lại nháp
  companyName      String?          @map("company_name") @db.VarChar(100) // ảnh chụp lúc phát hành
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz(3)
  publishedById    String?          @map("published_by_id") @db.Uuid
  createdById      String           @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  publishedBy User?     @relation("PayrollRunPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  createdBy   User      @relation("PayrollRunCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payslips    Payslip[]

  @@index([publishedById])
  @@index([createdById])
  @@map("payroll_runs")
}

/// Phiếu — mọi số là ẢNH CHỤP (ADR-125). Bản điều chỉnh = dòng mới `revision + 1`; bản cũ chỉ được đặt `superseded_at`.
model Payslip {
  id                 String    @id @db.Uuid
  runId              String    @map("run_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  revision           Int       @default(1)
  lockVersion        Int       @default(1) @map("lock_version")
  fullName           String    @map("full_name") @db.VarChar(100)
  level              String?   @db.VarChar(32) // NULL = thiếu hồ sơ lương (chặn phát hành)
  baseSalary         BigInt?   @map("base_salary")
  hireDate           DateTime? @map("hire_date") @db.Date
  seniorityYears     Int       @default(0) @map("seniority_years") @db.SmallInt
  seniorityAllowance BigInt    @default(0) @map("seniority_allowance")
  paidHalfDays       Int       @map("paid_half_days") @db.SmallInt
  overrideHalfDays   Int?      @map("override_half_days") @db.SmallInt
  overrideReason     String?   @map("override_reason") @db.VarChar(500)
  revisionReason     String?   @map("revision_reason") @db.VarChar(500)
  salaryByDays       BigInt    @map("salary_by_days")
  incomeTotal        BigInt    @map("income_total")
  bonusTotal         BigInt    @map("bonus_total")
  deductionTotal     BigInt    @map("deduction_total")
  netPay             BigInt    @map("net_pay") // có thể âm trên NHÁP (chặn phát hành)
  note               String?   @db.VarChar(1000)
  hasSickDays        Boolean   @default(false) @map("has_sick_days")
  supersededAt       DateTime? @map("superseded_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  run   PayrollRun    @relation(fields: [runId], references: [id], onDelete: Restrict)
  user  User          @relation("PayslipUser", fields: [userId], references: [id], onDelete: Restrict)
  lines PayslipLine[]

  @@unique([runId, userId, revision])
  @@unique([runId, userId], map: "payslips_current_key", where: raw("superseded_at IS NULL"))
  @@index([userId])
  @@map("payslips")
}

/// Dòng kế toán gõ tay (thâm niên KHÔNG là dòng — cột `seniority_allowance`). ≤ 50 / phiếu ở contract.
model PayslipLine {
  id        String         @id @db.Uuid
  payslipId String         @map("payslip_id") @db.Uuid
  section   PayslipSection
  label     String         @db.VarChar(120)
  amount    BigInt
  sortOrder Int            @map("sort_order") @db.SmallInt

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@unique([payslipId, sortOrder])
  @@map("payslip_lines")
}
