# Mẫu cho apps/web/.env.local (dev). Đọc LÚC CHẠY bởi server Next — KHÔNG dùng tiền tố NEXT_PUBLIC_
# (ADR-074, frontend.md §3.6). Cổng local theo ADR-097: web 3001, API 4000.
API_URL=http://localhost:4000/api/v1
# Mặc định = origin của API_URL.
WS_URL=http://localhost:4000
APP_ENV=local

# Mock API (T-019) — chạy web khi chưa có API thật: bật cờ và trỏ API_URL vào route mock cùng origin.
# Mock tự tắt ở APP_ENV=staging/production. Dữ liệu chỉ nằm trong bộ nhớ server Next (mất khi restart).
# APP_MOCK_API=1
# API_URL=http://localhost:3001/mock-api/v1
