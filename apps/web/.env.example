# Mẫu cho apps/web/.env.local (dev). Đọc LÚC CHẠY bởi server Next — KHÔNG dùng tiền tố NEXT_PUBLIC_
# (ADR-074, frontend.md §3.6). Cổng local theo ADR-097: web 3001, API 4000.
API_URL=http://localhost:4000/api/v1
# Mặc định = origin của API_URL.
WS_URL=http://localhost:4000
# BẮT BUỘC đặt ở dev: không đặt ⇒ coi là production (HSTS, upgrade-insecure-requests, tắt mock — T-029).
APP_ENV=local

# Mock API (T-019) — chạy web khi chưa có API thật: bật cờ và trỏ API_URL vào route mock cùng origin.
# Mock chỉ bật khi APP_ENV=local|test đặt tường minh (không đặt APP_ENV ⇒ coi là production). Dữ liệu chỉ nằm trong bộ nhớ server Next (mất khi restart).
# APP_MOCK_API=1
# API_URL=http://localhost:3001/mock-api/v1

# Sentry web (T-035) — DSN project `taskflow-web`; trống ⇒ tắt (cả tunnel /monitoring trả 404).
# Event trình duyệt đi qua /monitoring cùng origin ⇒ không nới CSP. Xem docs/runbook/alerts.md.
# SENTRY_DSN=
# release của Sentry = GIT_SHA (CI đặt lúc build/deploy)
# GIT_SHA=
