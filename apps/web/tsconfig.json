{
  "extends": "@taskflow/config/tsconfig/next.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app",
    "src",
    "test",
    "perf",
    "real-api",
    "*.config.ts",
    "proxy.ts",
    "instrumentation-client.ts",
    "instrumentation.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
